<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RazorEngine</RootNamespace>
    <!-- Own name and key, so the fork never collides with the original RazorEngine.dll (3.x). -->
    <AssemblyName>RazorEngine.NetFramework</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>

  <!-- Version and shared assembly attributes. Title and description stay in Properties\AssemblyInfo.cs. -->
  <PropertyGroup>
    <Version>4.0.0-preview.1</Version>
    <!-- Increase the last number with every release (previews too), so installers see a newer file. -->
    <FileVersion>4.0.0.1</FileVersion>
    <Company>RazorEngine</Company>
    <Product>RazorEngine</Product>
    <Copyright>RazorEngine Copyright © RazorEngine Project 2011-2017</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>RazorEngine.NetFramework</PackageId>
    <Authors>Matthew Abbott;Ben Dornis;Matthias Dittrich</Authors>
    <Description>RazorEngine - A templating engine based on the Razor parser, for .NET Framework 4.8.</Description>
    <PackageTags>C# razor template engine programming</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Matheis1992/RazorEngine</PackageProjectUrl>
    <!-- Points at the release tag (see Releasing in CONTRIBUTING.md), so the link shows the notes as of this version. -->
    <PackageReleaseNotes>https://github.com/Matheis1992/RazorEngine/blob/v$(Version)/doc/ReleaseNotes.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/Matheis1992/RazorEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\..\LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Razor" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Explicit so consumers get the tested versions instead of the lowest versions Roslyn allows. -->
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="System.Reflection.Metadata" />
    <!-- Roslyn 1.3.2 pulls in 4.1.0, which NuGet audit flags for CVE-2017-11770 (GHSA-7mfr-774f-w5r9).
         That CVE only affects .NET Core; on .NET Framework the built-in implementation is used anyway.
         Pinning a patched version keeps the audit warning away from this package and its consumers.
         Can be removed once Roslyn is updated. -->
    <PackageReference Include="System.Security.Cryptography.X509Certificates" />
  </ItemGroup>

</Project>
