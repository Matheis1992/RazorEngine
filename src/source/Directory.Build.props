<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shared by the shipped packages RazorEngine.NetFramework (RazorEngine.Core) and RazorEngine.NetFramework.Roslyn.
       Both are always released together with the same version. -->
  <PropertyGroup>
    <Version>5.0.0-rc.1</Version>
    <!-- Increase the last number with every release (previews too), so installers see a newer file. -->
    <FileVersion>5.0.0.1</FileVersion>
    <Company>RazorEngine</Company>
    <Product>RazorEngine</Product>
    <!-- Keep the original project's notice (Apache-2.0) and add the fork's. -->
    <Copyright>Copyright © 2011-2017 RazorEngine Project, © 2026 RazorEngine.NetFramework contributors</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Authors>Matthew Abbott;Ben Dornis;Matthias Dittrich</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Matheis1992/RazorEngine</PackageProjectUrl>
    <!-- Points at the GitHub release of this version (created by .github/workflows/release.yml). Its text can still be corrected after publishing, unlike the package. -->
    <PackageReleaseNotes>https://github.com/Matheis1992/RazorEngine/releases/tag/v$(Version)</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/Matheis1992/RazorEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- dotnet pack compares the public API with the last published version and fails on breaking changes. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
