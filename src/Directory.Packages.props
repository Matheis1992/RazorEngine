<Project>

  <!-- Central Package Management: all package versions live here, projects only name the packages. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- RazorEngine.Core: these become dependencies of the RazorEngine.NetFramework package. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNet.Razor" Version="3.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="1.3.2" />
    <PackageVersion Include="System.Collections.Immutable" Version="1.3.1" />
    <PackageVersion Include="System.Reflection.Metadata" Version="1.4.2" />
    <PackageVersion Include="System.Security.Cryptography.X509Certificates" Version="4.3.2" />
  </ItemGroup>

  <!-- RazorEngine.Mvc -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="Autofac" Version="9.3.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

</Project>
