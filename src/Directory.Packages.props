<Project>

  <!-- Central Package Management: all package versions live here, projects only name the packages. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Shipped packages: Microsoft.AspNet.Razor is the dependency of RazorEngine.NetFramework (RazorEngine.Core),
       Microsoft.CodeAnalysis.CSharp only of RazorEngine.NetFramework.Roslyn (RazorEngine.Roslyn). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNet.Razor" Version="3.3.0" />
    <!-- 5.6.0 is the newest Roslyn whose dependencies are all stable releases (5.9.0 depends on a prerelease analyzer package). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="Autofac" Version="9.3.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

</Project>
