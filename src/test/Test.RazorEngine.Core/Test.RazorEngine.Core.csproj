<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Test.RazorEngine</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <!-- NUnit 4+ relies on C# 13/14 features (overload resolution priority, extension members). -->
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Templating\Templates\*.cshtml" />
    <EmbeddedResource Include="Templating\Templates\*.cshtml" />
    <None Update="test\TestHelper.dll" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" PrivateAssets="all" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\source\RazorEngine.Core\RazorEngine.Core.csproj" />
  </ItemGroup>

</Project>
